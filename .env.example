# Optional: when the Vite dev server is on a different origin than the API, set the API base
# (see shared/apiClient.ts getApiOrigin / VITE_API_ORIGIN).
# VITE_API_ORIGIN="http://127.0.0.1:3000"

# Runtime port for the unified Express/Vite server.
PORT=3000

# Required once in production when no admin account exists.
# ADMIN_EMAIL="ops@example.com"
# ADMIN_PASSWORD="replace-with-a-strong-password"

# Development-only seed controls. Keep disabled in production.
# ALLOW_DEMO_SEED="false"

# Public app URL (deploy / links), if used by future features.
APP_URL="MY_APP_URL"
