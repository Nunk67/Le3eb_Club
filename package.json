{
  "name": "le3eb_club",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/server.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/backend/server.js",
    "preview": "vite preview",
    "clean": "rimraf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/golden tests/regression",
    "test:integration": "vitest run tests/integration",
    "test:golden": "vitest run tests/golden",
    "test:regression": "vitest run tests/regression",
    "test:smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate-policy.mjs && node scripts/validate-alg.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:import-json": "tsx scripts/migrate-json-to-pg.ts",
    "split:views": "node scripts/phase-g-fix.mjs && node scripts/phase-g-split-views.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.682.0",
    "@aws-sdk/s3-request-presigner": "^3.682.0",
    "@fingerprintjs/fingerprintjs": "^4.5.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.44.0",
    "@sentry/react": "^8.44.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dompurify": "^3.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "isomorphic-dompurify": "^2.18.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.0.3",
    "vite": "^6.2.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.21",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^2.1.8"
  }
}
